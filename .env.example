# Backend Python de Visión IA.
# Local: http://127.0.0.1:8000
# Deploy (Vercel): la URL del túnel ngrok, porque el backend corre en la PC del equipo.
VISION_BACKEND_URL=http://127.0.0.1:8000

# Basic-auth del túnel de visión, formato usuario:password. Sin NEXT_PUBLIC_ a propósito:
# se usa solo del lado del servidor y el navegador nunca la ve.
# Vacío en local (el backend en 127.0.0.1 no pide credenciales).
VISION_BACKEND_AUTH=

# Evidence API utilizada por el navegador.
# Deploy: la URL del túnel ngrok; tiene que ser https o el navegador bloquea el mixed content.
NEXT_PUBLIC_EVIDENCE_API_URL=http://127.0.0.1:8787

# Demo safety net of /api/vision/weeds (frontend proxy):
# VISION_DEMO_GUARD=0 trusts any model answer; by default an answer outside the band of the
# scene (bueno 0-25 %, mixto 30-60 %, malo 55-100 %) is replaced by the point preset.
# VISION_DEMO_ONLY=1 never calls the model (instant presets). VISION_TIMEOUT_MS defaults to 45000.
VISION_DEMO_GUARD=1
VISION_DEMO_ONLY=0
VISION_TIMEOUT_MS=45000

# Mock de vision por nombre de archivo (data/vision-mock.json). Activo por defecto:
# la demo no depende del tunel, de la PC del equipo ni de la cuota de Gemini.
# VISION_MOCK=0 vuelve a llamar al modelo real por VISION_BACKEND_URL.
VISION_MOCK=1

# Mocks del evidence-api (services/evidence-api). Activos por defecto, para que la demo
# no dependa de red. Ver services/evidence-api/README.md > "Mocks de demo".
#   CAPACITY_MOCK=0  el cupo vuelve a salir de la serie oficial + NDVI (capacidad-v2)
#   LOTES_MOCK=0     POST /lotes vuelve a construir el lote con datos reales (~5 s)
CAPACITY_MOCK=1
LOTES_MOCK=1
