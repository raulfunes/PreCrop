# Backend Python de Visión IA
VISION_BACKEND_URL=http://127.0.0.1:8000

# Evidence API utilizada por el navegador
NEXT_PUBLIC_EVIDENCE_API_URL=http://127.0.0.1:8787

# Demo safety net of /api/vision/weeds (frontend proxy):
# VISION_DEMO_GUARD=0 trusts any model answer; by default an answer outside the band of the
# scene (bueno 0-25 %, mixto 30-60 %, malo 55-100 %) is replaced by the point preset.
# VISION_DEMO_ONLY=1 never calls the model (instant presets). VISION_TIMEOUT_MS defaults to 45000.
VISION_DEMO_GUARD=1
VISION_DEMO_ONLY=0
VISION_TIMEOUT_MS=45000
